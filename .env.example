APP_NAME=ZemiConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.0.16 minimum (CHECK appliqués), InnoDB, utf8mb4. Pas de SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zemiconnect
DB_USERNAME=root
DB_PASSWORD=

# Sessions, cache et files d'attente en base MySQL (aucun Redis).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# localhost : cookie partagé entre localhost:3000 (Next) et localhost:8000 (API).
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Sanctum en mode SPA (cookies) : domaines du frontend autorisés à recevoir la session.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost
# Origine du frontend (CORS avec credentials, liens de réinitialisation).
FRONTEND_URL=http://localhost:3000
# Origine publique des QR imprimés (<PUBLIC_URL>/v/<jeton>).
PUBLIC_URL=http://localhost:3000

# « Rester connecté » : durée de la session longue, en jours.
AUTH_REMEMBER_DAYS=30

# Numéro ZemiConnect : préfixe (ZC- + 6 chiffres + 1 chiffre de contrôle Luhn).
ZEMI_NUMBER_PREFIX=ZC-

# Premier Administrateur (FirstAdminSeeder) : mot de passe à changer à la première connexion.
FIRST_ADMIN_EMAIL=admin@zemiconnect.local
FIRST_ADMIN_PASSWORD=ChangerMoi2026
FIRST_ADMIN_FIRST_NAME=Administrateur
FIRST_ADMIN_LAST_NAME=ZEMICONNECT

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@zemiconnect.local"
MAIL_FROM_NAME="${APP_NAME}"
